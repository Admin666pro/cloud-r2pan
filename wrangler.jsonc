{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-r2pan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // R2 与 D1 的绑定改由 Cloudflare 控制台手动配置（Worker → Settings → Bindings），
  // 这里不再声明，因此部署时不需要 database_id，真实 ID 永不进仓库，也无需环境变量注入。
  // 对应绑定名（勿改）：
  //   r2    → R2 Bucket（cloud-r2pan）
  //   db    → D1 Database（cloud-r2pan）
  //   admin → Secret（管理后台密钥）

  // 将 public/*.html 作为文本模块导入
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "observability": { "enabled": true }
}