{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-r2pan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cloud-r2pan",
      "database_id": "${CLOUDFLARE_D1_ID}"
    }
  ],

  "r2_buckets": [
    {
      "binding": "r2",
      "bucket_name": "cloud-r2pan"
    }
  ],

  "vars": {
    // 非敏感、可公开的配置
    // 敏感值（admin / turnstile / totp 恢复码）用 Secret 面板配，或在 .dev.vars / .env 里
  },

  // 将 public/*.html 作为文本模块导入
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "observability": { "enabled": true }
}
