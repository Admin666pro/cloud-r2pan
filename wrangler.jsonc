{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-r2pan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  "r2_buckets": [
    { "binding": "r2", "bucket_name": "cloud-r2pan" }
  ],
  "d1_databases": [
    { "binding": "db", "database_name": "cloud-r2pan", "database_id": "LOCAL_PLACEHOLDER" }
  ],

  // 将 public/*.html 作为文本模块导入
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "observability": { "enabled": true }
}